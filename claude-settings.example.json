{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "/home/user/your_path/hook.sh session-start", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "/home/user/your_path/hook.sh session-end", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "/home/user/your_path/hook.sh working", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "/home/user/your_path/hook.sh working", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "/home/user/your_path/hook.sh working", "timeout": 5 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "/home/user/your_path/hook.sh working", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "/home/user/your_path/hook.sh idle", "timeout": 5 } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [ { "type": "command", "command": "/home/user/your_path/hook.sh confirm", "timeout": 5 } ] },
      { "matcher": "idle_prompt", "hooks": [ { "type": "command", "command": "/home/user/your_path/hook.sh idle", "timeout": 5 } ] }
    ]
  }
}

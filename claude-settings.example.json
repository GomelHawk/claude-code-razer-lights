{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "curl.exe -s -m 2 http://127.0.0.1:8777/session-start", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "curl.exe -s -m 2 http://127.0.0.1:8777/session-end", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "curl.exe -s -m 2 http://127.0.0.1:8777/working", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "curl.exe -s -m 2 http://127.0.0.1:8777/working", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "curl.exe -s -m 2 http://127.0.0.1:8777/idle", "timeout": 5 } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [ { "type": "command", "command": "curl.exe -s -m 2 http://127.0.0.1:8777/confirm", "timeout": 5 } ] },
      { "matcher": "idle_prompt", "hooks": [ { "type": "command", "command": "curl.exe -s -m 2 http://127.0.0.1:8777/idle", "timeout": 5 } ] }
    ]
  }
}
